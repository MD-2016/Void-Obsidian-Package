# Template file for 'obsidian'
pkgname=obsidian
version=1.15.0
revision=1
archs="x86_64"
create_wrksrc=yes
short_desc="Powerful knowledge base that works on top of a local folder of plain text files"
maintainer="MD <programforcoffee89@gmail.com>"
license="Proprietary"
homepage="https://obsidian.md"
distfiles="https://github.com/obsidianmd/obsidian-releases/releases/download/v${version}/obsidian-${version}.tar.gz"
checksum="75594ae09914ca0191dde13c0697dee653322287a3a806c15519332d9ada14d3"

do_install() {
    # 1. Create the correct installation directory in /usr/lib
    vmkdir usr/lib/obsidian

    # 2. Copy the unpacked contents into /usr/lib/obsidian/
    vcopy "*" usr/lib/obsidian/

    # 3. Set required setuid permissions for the Electron sandbox binary
    if [ -f "${DESTDIR}/usr/lib/obsidian/chrome-sandbox" ]; then
        chmod 4755 "${DESTDIR}/usr/lib/obsidian/chrome-sandbox"
    fi

    # 4. Create /usr/bin and link the binary so it's globally in your PATH
    vmkdir usr/bin
    ln -s ../lib/obsidian/obsidian "${DESTDIR}/usr/bin/obsidian"

    # 5. Install the desktop icon entry (ensure you have obsidian.desktop in files/)
    vinstall "${FILESDIR}/obsidian.desktop" 644 usr/share/applications
}
