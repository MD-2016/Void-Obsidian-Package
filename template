# Template file for 'obsidian'
pkgname=obsidian
version=1.15.0
revision=2
archs="x86_64"
create_wrksrc=yes
short_desc="Powerful knowledge base that works on top of a local folder of plain text files"
maintainer="MD <programforcoffee89@gmail.com>"
license="Proprietary"
homepage="https://obsidian.md"
distfiles="https://github.com/obsidianmd/obsidian-releases/releases/download/v${version}/obsidian-${version}.tar.gz"
checksum="75594ae09914ca0191dde13c0697dee653322287a3a806c15519332d9ada14d3"
depends="alsa-lib dbus-glib gtk+3 libnotify nss libXtst libcxx"

do_install() {
    # 1. Create the correct installation directory in /usr/lib
    vmkdir usr/lib/obsidian

    # 2. Copy the unpacked contents into /usr/lib/obsidian/
    vcopy "*" usr/lib/obsidian/

    # 3. CRITICAL: Set root-owned setuid permissions (4755) for the Electron sandbox binary
    # Without this, Obsidian will fail to launch on modern Linux kernels due to sandboxing restrictions.
    if [ -f "${DESTDIR}/usr/lib/obsidian/chrome-sandbox" ]; then
        chown root:root "${DESTDIR}/usr/lib/obsidian/chrome-sandbox"
        chmod 4755 "${DESTDIR}/usr/lib/obsidian/chrome-sandbox"
    fi

    # 4. Create /usr/bin and link the binary so it's globally in your PATH
    vmkdir usr/bin
    ln -s ../lib/obsidian/obsidian "${DESTDIR}/usr/bin/obsidian"

    # 5. Install the .desktop file into the correct system-wide directory with 644 permissions
    vinstall "${FILESDIR}/obsidian.desktop" 644 usr/share/applications

    # 6. Install icon into standard scalable/pixmaps path for XFCE desktop integration
    if [ -f "${DESTDIR}/usr/lib/obsidian/obsidian.png" ]; then
        vmkdir usr/share/pixmaps
        ln -s ../lib/obsidian/obsidian.png "${DESTDIR}/usr/share/pixmaps/obsidian.png"
    elif [ -f "${FILESDIR}/obsidian.png" ]; then
        vinstall "${FILESDIR}/obsidian.png" 644 usr/share/pixmaps
    fi
}
